{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned-CCTU-compatible task row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "messages",
    "tools",
    "constraints_list",
    "codes",
    "unsolved_set",
    "answer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "messages": {
      "type": "array",
      "minItems": 1
    },
    "tools": {
      "type": "string",
      "description": "JSON-encoded tool array required by pinned CCTU"
    },
    "constraints_list": {
      "type": "array",
      "minItems": 4
    },
    "codes": {
      "type": "string"
    },
    "unsolved_set": {
      "type": "string"
    }
  }
}
